# Copy to .env and fill in. Never commit the real file - .env is gitignored.
#
# TradersPost owns broker credentials; this repo never holds a broker API
# key or a private key, and there is no code path that could use one.

# Webhook URL for the crypto universe's paper strategy in TradersPost.
# config/universe.yaml -> webhook_url_env names which variable a given
# universe reads; a second asset class adds a second variable here.
TRADERSPOST_WEBHOOK_URL_CRYPTO=

# Reconciliation only (cli.py reconcile) - see SPEC.md "Secrets" for why
# this exists at all. This key MUST be scoped read-only / view-only: no
# trade permission, no transfer/withdrawal permission. src/broker/client.py
# refuses to use a key that isn't. Never reuse a trading-capable key here.
BROKER_API_KEY_CRYPTO=
BROKER_API_SECRET_CRYPTO=
